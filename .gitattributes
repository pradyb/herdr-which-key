# Normalize line endings: force LF so launch.sh (run by sh) never gets CRLF
# when checked out on Windows, and diffs stay clean across platforms.

* text=auto eol=lf

*.py       text eol=lf
*.sh       text eol=lf
*.toml     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
.gitignore text eol=lf

# Never touch these.
*.png      binary
*.jpg      binary
*.gif      binary
